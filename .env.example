# Copia questo file in .env (in locale) o metti le stesse variabili su Vercel.

# Login: di solito vuoto, la password la scegli al primo avvio.
# Se vuoi fissarla qui: python backend/scripts/hash_password.py
APP_PASSWORD_HASH=
# Firma del cookie. Vuoto = la ricava l'app dai dati del database.
SECRET_KEY=
# 1 online (HTTPS), 0 in locale
COOKIE_SECURE=0
# Indirizzo dell'app, per i link nelle mail
APP_URL=http://localhost:5173

# Database. Vuoto = SQLite in backend/data/app.db.
# Online: la mette l'integrazione Supabase di Vercel (POSTGRES_URL), oppure la stringa "Transaction pooler" (porta 6543).
DATABASE_URL=
DB_SCHEMA=styleme

# Foto su Supabase Storage (vuoto = cartella locale backend/data/photos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=styleme

# Mail con Resend, come LAURUS. Di solito vuoti: chiave, mittente e destinatario si scrivono nell'app.
RESEND_API_KEY=
EMAIL_FROM=
MAIL_TO=

# Segreto del cron, facoltativo (se c'è, lo stesso va nei secret di GitHub)
CRON_SECRET=

# Push web (facoltativo). Chiavi con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo@indirizzo
